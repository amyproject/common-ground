{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/volunteer/:path*",
      "destination": "/api/volunteer?path=:path*"
    },
    {
      "source": "/learn",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/plan",
      "destination": "/plan/index.html"
    },
    {
      "source": "/canopy",
      "destination": "/canopy/index.html"
    },
    {
      "source": "/join",
      "destination": "/index.html"
    },
    {
      "source": "/volunteer",
      "destination": "/index.html"
    }
  ]
}
